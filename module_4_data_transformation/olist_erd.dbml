// Olist E-Commerce ERD
// Docs: https://dbml.dbdiagram.io/docs

Table customers {
  customer_id varchar [primary key, note: 'One per order, maps to customer_unique_id']
  customer_unique_id varchar [not null, note: 'Deduplicated customer identity']
  customer_zip_code_prefix varchar
  customer_city varchar
  customer_state varchar
}

Table orders {
  order_id varchar [primary key]
  customer_id varchar [not null]
  order_status varchar
  order_purchase_timestamp timestamp
  order_approved_at timestamp
  order_delivered_carrier_date timestamp
  order_delivered_customer_date timestamp
  order_estimated_delivery_date timestamp
}

Table order_items {
  order_id varchar [not null]
  order_item_id integer [not null, note: 'Sequential item number within the order']
  product_id varchar [not null]
  seller_id varchar [not null]
  shipping_limit_date timestamp
  price decimal
  freight_value decimal

  indexes {
    (order_id, order_item_id) [pk]
  }
}

Table order_payments {
  order_id varchar [not null]
  payment_sequential integer [not null, note: 'Sequential payment number within the order']
  payment_type varchar
  payment_installments integer
  payment_value decimal

  indexes {
    (order_id, payment_sequential) [pk]
  }
}

Table order_reviews {
  review_id varchar [not null, note: 'Not unique across dataset']
  order_id varchar [not null]
  review_score integer
  review_comment_title varchar
  review_comment_message text
  review_creation_date timestamp
  review_answer_timestamp timestamp

  indexes {
    (review_id, order_id) [pk]
  }
}

Table products {
  product_id varchar [primary key]
  product_category_name varchar
  product_name_lenght integer
  product_description_lenght integer
  product_photos_qty integer
  product_weight_g integer
  product_length_cm integer
  product_height_cm integer
  product_width_cm integer
}

Table sellers {
  seller_id varchar [primary key]
  seller_zip_code_prefix varchar
  seller_city varchar
  seller_state varchar
}

Table product_category_name_translation {
  product_category_name varchar [primary key]
  product_category_name_english varchar
}

// --- Relationships ---

Ref: orders.customer_id > customers.customer_id           // many orders to one customer record

Ref: order_items.order_id > orders.order_id                // many items per order
Ref: order_items.product_id > products.product_id          // many items reference one product
Ref: order_items.seller_id > sellers.seller_id             // many items fulfilled by one seller

Ref: order_payments.order_id > orders.order_id             // many payments per order

Ref: order_reviews.order_id > orders.order_id              // many reviews per order

Ref: products.product_category_name > product_category_name_translation.product_category_name  // category lookup
